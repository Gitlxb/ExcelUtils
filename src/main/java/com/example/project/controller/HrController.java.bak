package com.example.project.controller;

import com.example.project.service.hr.CfDuogeWenjZzService;
import com.example.project.service.hr.CfGzbcfHypService;
import com.example.project.service.hr.CfGzbcfHypSimpleService;
import com.example.project.service.hr.CfZdnrfyqNrcsWsxService;
import com.example.project.service.hr.HrGzbPipeiService;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.FileSystemResource;
import org.springframework.core.io.Resource;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Base64;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * 人事功能控制器
 * 对应 main.py 中"人事功能"分类下的功能按钮
 */
@RestController
@RequestMapping("/api/hr")
public class HrController {

    @Autowired
    private CfDuogeWenjZzService cfDuogeWenjZzService;

    @Autowired
    private CfGzbcfHypService cfGzbcfHypService;

    @Autowired
    private CfGzbcfHypSimpleService cfGzbcfHypSimpleService;

    @Autowired
    private CfZdnrfyqNrcsWsxService cfZdnrfyqNrcsWsxService;

    @Autowired
    private HrGzbPipeiService hrGzbPipeiService;

    @Value("${file.upload-dir:./uploads}")
    private String uploadDir;

    /**
     * POST /api/hr/split-to-files
     * 功能：拆分 Excel 为多个独立文件（cf_duoge_wenj_zz.py）
     * 特点：长数字文本保护、日期格式化、字母倒序排序
     */
    @PostMapping("/split-to-files")
    public Map<String, Object> splitToFiles(
            @RequestParam("file") MultipartFile file,
            @RequestParam("columns") String columns) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();

            String outputPath = cfDuogeWenjZzService.splitToFiles(file, columns, uploadDir);
            result.put("success", true);
            result.put("message", "拆分文件完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/hr/split-by-config
     * 功能：按"拆分参数"工作表配置自动拆分（cf_zdnrfyq_nrcs_wsx.py）
     */
    @PostMapping("/split-by-config")
    public Map<String, Object> splitByConfig(
            @RequestParam("file") MultipartFile file,
            @RequestParam("column") String column) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();

            String outputPath = cfZdnrfyqNrcsWsxService.splitByConfig(file, column, uploadDir);
            result.put("success", true);
            result.put("message", "按配置拆分完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    // ==================== 工资表拆分（cf_gzbcf_hyp） ====================

    /**
     * POST /api/hr/split-salary/sheets
     * 获取 Excel 文件的工作表列表
     */
    @PostMapping("/split-salary/sheets")
    public Map<String, Object> getSplitSalarySheets(@RequestParam("file") MultipartFile file) {
        Map<String, Object> result = new HashMap<>();
        try {
            List<String> sheets = cfGzbcfHypService.getSheetNames(file);
            result.put("success", true);
            result.put("sheets", sheets);
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/hr/split-salary/headers
     * 获取指定工作表第2行（表头行）的字段列表
     * headerRow 为 1-based，默认传 2 即可
     */
    @PostMapping("/split-salary/headers")
    public Map<String, Object> getSplitSalaryHeaders(
            @RequestParam("file") MultipartFile file,
            @RequestParam("sheetName") String sheetName,
            @RequestParam(value = "headerRow", defaultValue = "2") int headerRow) {
        Map<String, Object> result = new HashMap<>();
        try {
            List<String> headers = cfGzbcfHypService.getHeaders(file, sheetName, headerRow);
            result.put("success", true);
            result.put("headers", headers);
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/hr/split-salary/values
     * 获取指定列的唯一切片值
     */
    @PostMapping("/split-salary/values")
    public Map<String, Object> getSplitSalaryValues(
            @RequestParam("file") MultipartFile file,
            @RequestParam("sheetName") String sheetName,
            @RequestParam("colName") String colName) {
        Map<String, Object> result = new HashMap<>();
        try {
            List<String> values = cfGzbcfHypService.getColumnValues(file, sheetName, colName);
            result.put("success", true);
            result.put("values", values);
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/hr/split-salary
     * 功能：工资表拆分（cf_gzbcf_hyp.py）
     * 按指定列拆分工资表，保留格式和公式
     * 支持自定义分组（groups 参数），不传则按值各自拆分
     */
    @SuppressWarnings("unchecked")
    @PostMapping("/split-salary")
    public Map<String, Object> splitSalary(
            @RequestParam("file") MultipartFile file,
            @RequestParam("sheetName") String sheetName,
            @RequestParam("splitColName") String splitColName,
            @RequestParam(value = "groups", required = false, defaultValue = "") String groupsJson) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();

            String originalName = file.getOriginalFilename();
            String outputPath;
            if (groupsJson != null && !groupsJson.trim().isEmpty()) {
                // 解析 groups JSON，格式：[[\"IT部\",\"市场部\"],[\"行政部\"]]
                List<List<String>> groups = parseGroupsJson(groupsJson);
                outputPath = cfGzbcfHypService.splitSalaryWithGroups(file, originalName, sheetName, splitColName, groups, uploadDir);
            } else {
                outputPath = cfGzbcfHypService.splitSalary(file, originalName, sheetName, splitColName, uploadDir);
            }
            result.put("success", true);
            result.put("message", "工资表拆分完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    // ==================== 工资表拆分 - 简化版（cf_gzbcf_hyp_simple） ====================

    @PostMapping("/split-salary-simple/sheets")
    public Map<String, Object> getSplitSalarySimpleSheets(@RequestParam("file") MultipartFile file) {
        Map<String, Object> result = new HashMap<>();
        try {
            result.put("success", true);
            result.put("sheets", cfGzbcfHypSimpleService.getSheetNames(file));
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", e.getMessage());
        }
        return result;
    }

    @PostMapping("/split-salary-simple/headers")
    public Map<String, Object> getSplitSalarySimpleHeaders(
            @RequestParam("file") MultipartFile file,
            @RequestParam("sheetName") String sheetName,
            @RequestParam(value = "headerRow", defaultValue = "2") int headerRow) {
        Map<String, Object> result = new HashMap<>();
        try {
            result.put("success", true);
            result.put("headers", cfGzbcfHypSimpleService.getHeaders(file, sheetName, headerRow));
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", e.getMessage());
        }
        return result;
    }

    @PostMapping("/split-salary-simple/values")
    public Map<String, Object> getSplitSalarySimpleValues(
            @RequestParam("file") MultipartFile file,
            @RequestParam("sheetName") String sheetName,
            @RequestParam("colName") String colName) {
        Map<String, Object> result = new HashMap<>();
        try {
            result.put("success", true);
            result.put("values", cfGzbcfHypSimpleService.getColumnValues(file, sheetName, colName));
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", e.getMessage());
        }
        return result;
    }

    @SuppressWarnings("unchecked")
    @PostMapping("/split-salary-simple")
    public Map<String, Object> splitSalarySimple(
            @RequestParam("file") MultipartFile file,
            @RequestParam("sheetName") String sheetName,
            @RequestParam("splitColName") String splitColName,
            @RequestParam(value = "groups", required = false, defaultValue = "") String groupsJson) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();
            String originalName = file.getOriginalFilename();
            String outputPath;
            if (groupsJson != null && !groupsJson.trim().isEmpty()) {
                List<List<String>> groups = parseGroupsJson(groupsJson);
                outputPath = cfGzbcfHypSimpleService.splitSalaryWithGroups(file, originalName, sheetName, splitColName, groups, uploadDir);
            } else {
                outputPath = cfGzbcfHypSimpleService.splitSalary(file, originalName, sheetName, splitColName, uploadDir);
            }
            result.put("success", true);
            result.put("message", "工资表拆分完成（简化版）");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    private final ObjectMapper objectMapper = new ObjectMapper();

    /**
     * 解析 groups JSON（Base64 + Jackson），格式：[[\"a\",\"b\"],[\"c\"]]
     */
    private List<List<String>> parseGroupsJson(String encoded) {
        List<List<String>> groups = new ArrayList<>();
        if (encoded == null || encoded.trim().isEmpty()) return groups;
        try {
            // Base64 解码
            byte[] decoded = Base64.getDecoder().decode(encoded);
            String json = new String(decoded, StandardCharsets.UTF_8);
            groups = objectMapper.readValue(json, new TypeReference<List<List<String>>>() {});
        } catch (Exception e) {
            // 解析失败返回空，让 Service 走普通拆分
        }
        return groups;
    }

    // ==================== 工资表匹配（rs_gzb_pipei） ====================

