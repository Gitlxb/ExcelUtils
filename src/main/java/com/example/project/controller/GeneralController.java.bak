package com.example.project.controller;

import com.example.project.service.general.BiaogegesiZhService;
import com.example.project.service.general.CfBiaogeLiService;
import com.example.project.service.general.CfDuogeWenjService;
import com.example.project.service.general.NcengjiwenjjFzztService;
import com.example.project.service.general.ZhPdfExcelService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.FileSystemResource;
import org.springframework.core.io.Resource;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.util.HashMap;
import java.util.Map;

/**
 * 通用功能控制器
 * 对应 main.py 中"通用功能"分类下的所有按钮
 */
@RestController
@RequestMapping("/api/general")
public class GeneralController {

    @Autowired
    private CfBiaogeLiService cfBiaogeLiService;

    @Autowired
    private CfDuogeWenjService cfDuogeWenjService;

    @Autowired
    private NcengjiwenjjFzztService ncengjiwenjjFzztService;

    @Autowired
    private BiaogegesiZhService biaogegesiZhService;

    @Autowired
    private ZhPdfExcelService zhPdfExcelService;

    @Value("${file.upload-dir:./uploads}")
    private String uploadDir;

    /**
     * POST /api/general/split-to-sheets
     * 功能：按列拆分为多个工作表（cf_biaoge_li.py）
     */
    @PostMapping("/split-to-sheets")
    public Map<String, Object> splitToSheets(
            @RequestParam("file") MultipartFile file,
            @RequestParam("column") String column) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();

            String outputPath = cfBiaogeLiService.splitToSheets(file, column, uploadDir);
            result.put("success", true);
            result.put("message", "拆分工作表完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/general/split-to-files
     * 功能：按列拆分为多个独立 Excel 文件，打包为 ZIP（cf_duoge_wenj.py）
     */
    @PostMapping("/split-to-files")
    public Map<String, Object> splitToFiles(
            @RequestParam("file") MultipartFile file,
            @RequestParam("columns") String columns) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();

            String outputPath = cfDuogeWenjService.splitToFiles(file, columns, uploadDir);
            result.put("success", true);
            result.put("message", "拆分文件完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/general/extract-files
     * 功能：从ZIP中提取嵌套文件夹的所有文件（Ncengjiwenjj_fzzt.py）
     */
    @PostMapping("/extract-files")
    public Map<String, Object> extractFiles(@RequestParam("file") MultipartFile file) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();

            String outputPath = ncengjiwenjjFzztService.extractFilesFromZip(file, uploadDir);
            result.put("success", true);
            result.put("message", "文件提取完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/general/convert-format
     * 功能：表格格式转换（biaogegesi_zh.py）
     * 将 ZIP 包内的 .xls/.csv 等批量转为 .xlsx
     */
    @PostMapping("/convert-format")
    public Map<String, Object> convertFormat(@RequestParam("file") MultipartFile file) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();
            String outputPath = biaogegesiZhService.convertToXlsx(file, uploadDir);
            result.put("success", true);
            result.put("message", "格式转换完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    /**
     * POST /api/general/pdf-to-excel
     * 功能：PDF 转 Excel（zh_pdf_Excel.py）
     */
    @PostMapping("/pdf-to-excel")
    public Map<String, Object> pdfToExcel(@RequestParam("file") MultipartFile file) {
        Map<String, Object> result = new HashMap<>();
        try {
            File dir = new File(uploadDir);
            if (!dir.exists()) dir.mkdirs();
            String outputPath = zhPdfExcelService.convertPdfToExcel(file, uploadDir);
            result.put("success", true);
            result.put("message", "PDF 转换完成");
            result.put("fileName", new File(outputPath).getName());
        } catch (Exception e) {
            result.put("success", false);
            result.put("message", "处理失败：" + e.getMessage());
        }
        return result;
    }

    /**
     * GET /api/general/download/{fileName}
     * 下载通用功能生成的文件
     */
    @GetMapping("/download/{fileName}")
    public ResponseEntity<Resource> downloadFile(@PathVariable String fileName) {
        try {
            File file = new File(uploadDir, fileName);
            if (!file.exists()) {
                return ResponseEntity.notFound().build();
            }
            Resource resource = new FileSystemResource(file);
            return ResponseEntity.ok()
                    .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"" + file.getName() + "\"")
                    .contentType(MediaType.APPLICATION_OCTET_STREAM)
                    .body(resource);
        } catch (Exception e) {
            return ResponseEntity.internalServerError().build();
        }
    }
}
